# ---------------------------------------------------------------- HTTP
# 3000 is deliberately left free for a Rails app.
PORT=4010
HOST=0.0.0.0
BASE_PATH=/v2.5
LOG_LEVEL=info

# ------------------------------------------------------ Authentication
# Comma separated; the first one is reported as the organisation's key.
API_KEYS=esimgo-mock-key
# Empty means every source IP is allowed.
IP_WHITELIST=

# --------------------------------------------------------- Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT=10
RATE_LIMIT_WINDOW_MS=1000

# -------------------------------------------------------- Organisation
ORG_NAME=Spoon Mock Travel Co
ORG_CURRENCY=USD
ORG_BALANCE=10000
ORG_TEST_CREDIT=500
ORG_LOW_BALANCE_THRESHOLD=2600

# ------------------------------------------------------------ Webhooks
# Where usage and lifecycle callbacks are POSTed. Empty = log only.
CALLBACK_URL=
# V3 signs the raw body with HMAC-SHA256 using the API key; V2 is unsigned.
CALLBACK_VERSION=V3

# ---------------------------------------------------------- Simulation
SIM_TICK_MS=2000
SIM_AUTO_USAGE=true
SIM_BYTES_PER_SECOND=250000
SIM_AUTO_INSTALL_AFTER_MS=10000
SIM_PROCESSING_MS=3000
SIM_INACTIVITY_DAYS=180
SIM_DELETION_GRACE_DAYS=7
SIM_INVENTORY_EXPIRY_DAYS=365

# --------------------------------------------------------------- Seeds
SEED_ESIMS=3
SEED_INVENTORY=true

# ----------------------------------------------------------- Catalogue
# 0 = generate single country bundles for every known country.
CATALOGUE_COUNTRY_LIMIT=0

# ------------------------------------------------------------ Profiles
SMDP_ADDRESS=rsp.esim-go-mock.local

# --------------------------------------------------------- Persistence
# Empty = pure in-memory. Set a path to snapshot state on shutdown.
STATE_PATH=
